SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

FRONTEND_URL=http://localhost:5173

# Secreto del cron (GitHub Actions) para POST /api/admin/recordatorios/ejecutar. Generar uno largo y aleatorio.
