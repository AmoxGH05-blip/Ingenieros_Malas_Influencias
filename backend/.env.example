PORT=3000

# Supabase (PostgreSQL) - Project Settings > Database > Connection parameters
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSL=true

JWT_SECRET=
