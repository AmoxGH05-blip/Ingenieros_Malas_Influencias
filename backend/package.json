{
  "name": "dygsis-backend",
  "version": "0.1.0",
  "description": "Backend (Express + TypeScript) del Sistema de Informacion de Evaluacion Docente Adaptable",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vitest": "^5.0.1"
  }
}
